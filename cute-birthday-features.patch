@@ -0,0 +1,87 @@
+import { useEffect, useMemo, useState } from 'react'
+
+type GuideMessage = { id: string; text: string }
+
+const guideMessages: GuideMessage[] = [
+  { id: 'home', text: 'ဟိုင်း ကလေးလေး 👋 ကိုကို့ surprise ထဲ ရောက်လာပြီနော် 💕' },
+  { id: 'reasons', text: 'ဒီကတ်လေးတွေ တစ်ခုချင်းနှိပ်ကြည့်နော် 💗' },
+  { id: 'timeline', text: 'အမှတ်တရလေးတွေ ပြန်ကြည့်ရအောင် 📖' },
+  { id: 'gallery', text: 'ပုံတွေနဲ့ video တွေကို နှိပ်ကြည့်လို့ရတယ်နော် 📸' },
+  { id: 'letters', text: 'စာအိတ်လေးတွေ ဖွင့်ကြည့်နော်… တစ်ခုချင်းစီမှာ စာရှိတယ် 💌' },
+  { id: 'scratch', text: 'ဟေး! ဒီကတ်ကို လက်နဲ့ခြစ်ကြည့် 🎁✨' },
+  { id: 'game', text: 'Pair အားလုံး ရှာနိုင်မလား 👀 Winner အတွက် prize ရှိတယ်နော်!' },
+  { id: 'final', text: 'အဆုံးနားရောက်ပြီ… ဒါပေမဲ့ surprise မကုန်သေးဘူးနော် ❤️' },
+  { id: 'wish', text: 'နောက်ဆုံး ဆုတောင်းတစ်ခုတောင်းပြီး candle လေးပိတ်နော် 🎂✨' },
+]
+
+export default function CharacterGuide() {
+  const availableMessages = useMemo(
+    () => guideMessages.filter((item) => document.getElementById(item.id)),
+    [],
+  )
+  const [active, setActive] = useState(availableMessages[0]?.id ?? 'home')
+  const [bubbleOpen, setBubbleOpen] = useState(true)
+
+  useEffect(() => {
+    const sections = guideMessages
+      .map((item) => document.getElementById(item.id))
+      .filter((section): section is HTMLElement => Boolean(section))
+
+    if (!sections.length) return
+
+    const observer = new IntersectionObserver(
+      (entries) => {
+        const visible = entries
+          .filter((entry) => entry.isIntersecting)
+          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
+
+        if (visible?.target.id) setActive(visible.target.id)
+      },
+      { rootMargin: '-30% 0px -45% 0px', threshold: [0, 0.15, 0.35, 0.6] },
+    )
+
+    sections.forEach((section) => observer.observe(section))
+    return () => observer.disconnect()
+  }, [])
+
+  useEffect(() => {
+    setBubbleOpen(true)
+    const timer = window.setTimeout(() => setBubbleOpen(false), 5500)
+    return () => window.clearTimeout(timer)
+  }, [active])
+
+  const current = guideMessages.find((item) => item.id === active) ?? guideMessages[0]
+
+  return (
+    <div className="cute-guide-root" aria-live="polite">
+      <style>{`
+        .cute-guide-root{position:fixed;right:18px;bottom:18px;z-index:2147482000;display:flex;align-items:flex-end;gap:10px;pointer-events:none}
+        .cute-guide-bubble{position:relative;max-width:min(285px,calc(100vw - 105px));padding:13px 15px;border-radius:18px 18px 4px 18px;background:#fff;color:#5f4650;box-shadow:0 16px 45px rgba(76,44,55,.18);border:1px solid rgba(217,99,124,.17);font-size:.88rem;line-height:1.55;opacity:0;transform:translateY(8px) scale(.96);transition:.22s ease;pointer-events:auto}
+        .cute-guide-bubble.show{opacity:1;transform:none}
+        .cute-guide-bubble::after{content:'';position:absolute;right:-8px;bottom:8px;border-left:10px solid #fff;border-top:8px solid transparent;border-bottom:8px solid transparent}
+        .cute-guide-mascot{position:relative;width:66px;height:66px;border:0;border-radius:22px;background:linear-gradient(145deg,#fff,#ffe8ee);box-shadow:0 14px 38px rgba(112,58,76,.2);display:grid;place-items:center;font-size:38px;cursor:pointer;pointer-events:auto;animation:guideFloat 2.6s ease-in-out infinite}
+        .cute-guide-mascot:hover{transform:scale(1.05)}
+        .cute-guide-heart{position:absolute;right:-5px;top:-7px;font-size:20px;animation:guideHeart 1.25s ease-in-out infinite}
+        .cute-guide-tip{position:absolute;right:4px;bottom:-10px;background:#d9637c;color:#fff;border-radius:999px;padding:2px 7px;font-size:9px;font-weight:800;letter-spacing:.04em;white-space:nowrap}
+        @keyframes guideFloat{50%{transform:translateY(-7px) rotate(2deg)}}
+        @keyframes guideHeart{50%{transform:scale(1.22) rotate(8deg)}}
+        @media(max-width:640px){.cute-guide-root{right:10px;bottom:10px}.cute-guide-mascot{width:58px;height:58px;border-radius:19px;font-size:34px}.cute-guide-bubble{font-size:.8rem;padding:11px 13px;max-width:calc(100vw - 86px)}}
+      `}</style>
+
+      <div className={`cute-guide-bubble ${bubbleOpen ? 'show' : ''}`}>
+        {current.text}
+      </div>
+
+      <button
+        type="button"
+        className="cute-guide-mascot"
+        onClick={() => setBubbleOpen((value) => !value)}
+        aria-label={bubbleOpen ? 'Hide guide message' : 'Show guide message'}
+      >
+        🧸
+        <span className="cute-guide-heart">💗</span>
+        <span className="cute-guide-tip">tap me</span>
+      </button>
+    </div>
+  )
+}
